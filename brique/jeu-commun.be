# Jeu commun
# Un seul grand jeu de plateforme (on grimpe, saut mural, ressorts) : les niveaux s'enchainent (NIVS), chacun signe par son auteur (QUI).
# NIV = le niveau que tu changes. Le niveau : 20 cases de large, autant de lignes que tu veux (on part du bas, on monte jusqu'au drapeau)
# # bloc | C fragile | ^ pic | W scie | R ressort | I glace | * etoile | S depart | G drapeau | . vide
# Case (c, r) : colonne c de 0 a 19, ligne r de NIV (0 en haut, H - 1 = la ligne du bas) ; en pixels x = c * T, y = r * T (T = 16). Le heros : px, py, 10 x 14 pixels.
# Le bas du niveau est toujours en bas de l'ecran. Nouvelle sorte de case : une lettre de plus, placee dans NIV, son effet dans plein() ou maj(), son dessin dans dessine().
import string
var NIV = [
"....................",
"....................",
"....................",
"....................",
"....................",
"....................",
"....................",
"..........G.........",
"........#####.......",
"....................",
"....................",
"....................",
".S..................",
"####R...............",
"#####..............."]
var NIVS = [NIV,
["....................","....................","....................","....................","....................","................G...","..............#####.","....................","....................","...*......*.........","..###...............",".........##R##......","....................","....................","....................",".S..................","####R...............","#####..............."],
["....................","....................","....................","....................","....................","..............G.....","............#####...","....................","....................",".........*......*...","...............###..","........##R##.......","....................","....................","....................",".S..................","####R...............","#####..............."],
["....................","....................","....................","....................","....................","...........G........",".........#####......","....................","....................","........*......*....",".......###..........","..............##R##.","....................","....................","..........*.........","....................",".........##R##......","....................","....................","....................",".S..................","####R...............","#####..............."],
["....................","....................","....................","....................","....................","..........G.........","........#####.......","....................","....................",".............*...*..","..........W.....##^.","............##R##...","....................","....................",".........*..........","....................","........##R##.......","....................","....................","....................",".S..................","####R...............","#####..............."],
["....................","....................","....................","....................","....................","......G.............","....#####...........","....................","....................","..........*.........","....................",".........##R##......","....................","....................","........*......*....",".......##^.W........","..............##R##.","....................","....................","..........*.........","....................",".........##R##......","....................","....................","....................",".S..................","####R...............","#####..............."],
["....................","....................","....................","....................","....................","......G.............","....#####...........","....................","....................",".........*..........","....................","........##R##.......","....................","....................",".............*...*..","..........W.....##^.","............##R##...","....................","....................",".........*..........","....................","........##R##.......","....................","....................","....................",".S..................","####R...............","#####..............."],
["....................","....................","....................",".........G..........","....................","......*.............","....................","....................",".........R..........","....................","....................","....................","...R................","....................","...........*........","....................","........R...........","....................","....................","....................","....................","..............R.....","....................","............*.......","....................","....................",".........R..........","....................","....................","....................",".S..................","####R###############","####################"],
["....................","....................","....................","............G.......","....................","....................","....................","...........RR.......","....................",".........*..........","....................",".......RR...........","....................","....................","....................","...........RR.......","....................",".............*......","....................","...............RR...","....................","....................","....................","...........RR.......","....................","..........*.........","....................",".......RR...........","....................","....................",".S..................","####R###############","####################"],
["....................","....................","....................","....................","....................","................G...","..............#####.","....................","....................","..........*.........","....................",".........##R##......","....................","....................",".....*..............","....................","....##R##...........","....................","....................","...*......*.........","..##^...............",".........##R##......","....................","....................","...............*....","...........W........","..............##R##.","....................","....................","..........*.........","....................",".........##R##......","....................","....................","....................",".S..................","####R...............","#####..............."]]
var QUI = ["Brique", "Brique", "Brique", "Brique", "Brique", "Brique", "Brique", "Brique", "Brique", "Brique"]
# fin des niveaux
var T = 16 var H = 0
var SX = 0.0 var SY = 0.0
var CASSE = {}                                  # cases qui disparaissent (fragile, trou...) : r * 20 + c -> temps ou elle disparait ; r = H - 1 pour la ligne du bas
var EX = [] var EY = [] var PRIS = []
var px = 0.0 var py = 0.0 var vx = 0.0 var vy = 0.0 var sol = false var mur = 0 var elan = 0.0
var lv = 0 var camy = 0 var pts = 0 var gagne = false var morts = 0 var t0 = 0.0 var chrono = 0.0
var CIEL = 0 var CIEL2 = 0 var BLOC = 0 var BORD = 0 var FRAG = 0 var PIC = 0 var RESS = 0 var GLACE = 0 var OR = 0 var HERO = 0 var OEIL = 0 var BLANC = 0 var OMBRE = 0

def case(c, r)
  if c < 0 || c >= 20 return "#" end                # les bords de l'ecran sont des murs
  if r < 0 || r >= H return "." end
  var k = NIV[r][c]
  if k != "." && CASSE.contains(r * 20 + c) && temps() > CASSE[r * 20 + c] return "." end
  return k
end
def plein(c, r) var k = case(c, r) return k == "#" || k == "C" || k == "R" || k == "I" end
def libre(x, y)
  var c0 = int(x / T) var c1 = int((x + 9) / T) var r0 = int(y / T) var r1 = int((y + 13) / T)
  return !(plein(c0, r0) || plein(c1, r0) || plein(c0, r1) || plein(c1, r1))
end
def depart() px = SX py = SY vx = 0.0 vy = 0.0 elan = 0.0 CASSE = {} end

def charge(i)                                     # le niveau i du jeu
  lv = i NIV = NIVS[i] H = size(NIV) EX = [] EY = [] PRIS = []
  for r: 0 .. H - 1
    for c: 0 .. 19
      var k = NIV[r][c]
      if k == "S" SX = c * T + 3.0 SY = r * T + 2.0 end
      if k == "*" EX.push(c) EY.push(r) PRIS.push(false) end
    end
  end
  depart()
end

def debut()
  CIEL = rgb(40, 52, 96) CIEL2 = rgb(70, 86, 140) BLOC = rgb(109, 91, 208) BORD = rgb(160, 146, 240) FRAG = rgb(160, 112, 60)
  PIC = rgb(230, 230, 236) RESS = rgb(255, 212, 0) GLACE = rgb(150, 230, 255) OR = rgb(255, 212, 0) HERO = rgb(232, 70, 60) OEIL = rgb(255, 255, 255) BLANC = rgb(255, 255, 255) OMBRE = rgb(20, 24, 40)
  charge(0) t0 = temps()
end

def maj(dt)
  if gagne
    if appui(P3)
      pts = 0 gagne = false morts = 0 charge(0) t0 = temps()
    end
    return
  end
  chrono = temps() - t0
  var glace = case(int((px + 5) / T), int((py + 15) / T)) == "I"
  var but = 0.0
  if bouton(G) but = -140.0 end
  if bouton(D) but = 140.0 end
  vx += (but - vx) * (glace ? 2 : 14) * dt          # sur la glace, on glisse
  if elan != 0 vx = elan elan *= 0.9 if elan * elan < 400 elan = 0.0 end end
  # contre un mur en l'air : on glisse doucement, P3 = saut mural
  mur = 0
  if !sol && bouton(G) && !libre(px - 1, py) mur = -1 end
  if !sol && bouton(D) && !libre(px + 1, py) mur = 1 end
  if mur != 0 && vy > 70 vy = 70.0 end
  if appui(P3)
    if sol vy = -450.0 son(660, 40)
    elif mur != 0 vy = -420.0 elan = -mur * 190.0 son(780, 40)
    end
  end
  if !bouton(P3) && vy < -160 vy = -160.0 end        # P3 lache tot = petit saut
  vy += 1400 * dt
  if vy > 500 vy = 500.0 end
  var nx = px + vx * dt
  if libre(nx, py) px = nx
  elif vx > 0 px = int((nx + 9) / T) * T - 10.0 vx = 0.0 elan = 0.0
  else px = (int(nx / T) + 1) * T + 0.0 vx = 0.0 elan = 0.0
  end
  var ny = py + vy * dt
  if libre(px, ny) py = ny
  elif vy > 0
    py = int((ny + 13) / T) * T - 14.0 vy = 0.0
    var r = int((py + 15) / T)
    for c: [int(px / T), int((px + 9) / T)]
      var k = case(c, r)
      if k == "R" vy = -560.0 son(990, 60) end       # ressort
      if k == "C" && !CASSE.contains(r * 20 + c) CASSE[r * 20 + c] = temps() + 0.5 end
    end
  else py = (int(ny / T) + 1) * T + 0.0 vy = 0.0
  end
  sol = vy >= 0 && !libre(px, py + 1)
  var cc = int((px + 5) / T) var cr = int((py + 7) / T)
  var bas = case(cc, int((py + 13) / T)) var ici = case(cc, cr)
  if ici == "^" || bas == "^" || ici == "W" || bas == "W" || py > H * T
    morts += 1 son(150, 200) depart() return
  end
  for i: 0 .. size(EX) - 1
    if !PRIS[i] && EX[i] == cc && EY[i] == cr PRIS[i] = true pts += 1 score(pts) son(988, 60) end
  end
  if case(cc, cr) == "G"                            # drapeau : niveau suivant, ou fin du jeu
    if lv + 1 < size(NIVS) charge(lv + 1) son(1320, 150) else gagne = true son(1320, 300) end
  end
  camy = int(py) - 140
  if camy < 0 camy = 0 end
  if camy > H * T - 240 camy = H * T - 240 end      # niveau moins haut que l'ecran : camy < 0, le sol reste en bas
end

def dessine()
  fond(CIEL)
  var b = 0 while b < 6 rect(0, b * 40 + 20, 320, 20, CIEL2) b += 1 end
  camera(0, camy)
  var r = camy / T var rf = r + 16
  if r < 0 r = 0 end
  if rf > H rf = H end
  while r < rf
    var c = 0
    while c < 20
      var k = case(c, r) var x = c * T var y = r * T
      if k == "#" rect(x, y, T, T, BLOC) rect(x, y, T, 2, BORD)
      elif k == "C" rect(x, y, T, 6, (CASSE.contains(r * 20 + c) && int(temps() * 20) % 2) ? OMBRE : FRAG)
      elif k == "I" rect(x, y, T, T, GLACE)
      elif k == "R" rect(x, y + 8, T, 8, BLOC) rect(x + 2, y + 4, 12, 4, RESS)
      elif k == "^" tri(x, y + T, x + 8, y + 4, x + T, y + T, PIC)
      elif k == "W" disque(x + 8, y + 8, 7, PIC) disque(x + 8, y + 8, 3, OMBRE)
      elif k == "G" rect(x + 7, y, 2, T, BLANC) tri(x + 9, y, x + 9, y + 8, x + T, y + 4, HERO)
      end
      c += 1
    end
    r += 1
  end
  for i: 0 .. size(EX) - 1
    if !PRIS[i] disque(EX[i] * T + 8, EY[i] * T + 8 + int(temps() * 4) % 2, 4, OR) end
  end
  var x = int(px) var y = int(py)
  rect(x + 2, y + 2, 10, 14, OMBRE) rect(x, y, 10, 14, HERO)
  rect(x + (vx < 0 ? 1 : 5), y + 3, 4, 4, OEIL)
  camera(0, 0)
  var s = string.format("%d * %.1f s", pts, chrono)
  texte(5, 5, s, OMBRE, 2) texte(4, 4, s, BLANC, 2)
  if size(NIVS) > 1
    var q = string.format("Niveau %d/%d  %s", lv + 1, size(NIVS), QUI[lv])
    texte(5, 25, q, OMBRE, 1) texte(4, 24, q, BLANC, 1)
  end
  if gagne texte(61, 101, "Gagne !", OMBRE, 4) texte(60, 100, "Gagne !", BLANC, 4) end
end
